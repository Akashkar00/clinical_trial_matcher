# API keys for the clinical trial matcher.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Required: Groq API key for LLM extraction + scoring + reranking.
GROQ_API_KEY=gsk_your_groq_key_here

# Optional: enables LangSmith tracing of every node + LLM call.
# Without this, @traceable decorators are silent no-ops.
# LANGSMITH_API_KEY=lsv2_pt_your_key_here
# LANGSMITH_PROJECT=clinical-trial-matcher

# Optional: Qdrant connection. Defaults to local on-disk storage.
# Use QDRANT_URL when running Qdrant as a service (docker-compose).
# QDRANT_URL=http://localhost:6333
# QDRANT_PATH=./qdrant_storage

# Optional: FastAPI server port (default 8000).
# FASTAPI_PORT=8000

# Optional: Streamlit target API URL (default http://localhost:8000).
# Set this if running FastAPI on a different host/port.
# API_BASE_URL=http://localhost:8000
